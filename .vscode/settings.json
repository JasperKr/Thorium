{
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build/",
    ],
    // Set default indentation to 2 spaces

    "editor.tabSize": 2,

    "[glsl]": {
        "editor.formatOnSave": false
    },

    // Not optimal, but i hate the whole explorer being cluttered with
    // third party libraries when you just want to quickly open a file.
    "files.exclude": {
        "**/include": true,
        "**/external": true,
        "**/third_party": true
    }
}